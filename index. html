<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hindi Tools Hub</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#fff;
  color:#202124;
}
header{
  padding:22px 7%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  border-bottom:1px solid #eee;
}
.logo{font-size:23px;font-weight:bold;color:#4285f4}
.logo span{color:#ea4335}
.hero{text-align:center;padding:65px 15px 35px}
.hero h1{font-size:42px;margin:0 0 15px}
.hero p{color:#666}
.search{
  max-width:600px;margin:28px auto;
  display:flex;border:1px solid #ddd;
  border-radius:30px;padding:13px 20px;
  box-shadow:0 2px 8px #ddd;
}
.search input{
  border:0;outline:0;flex:1;
  font-size:16px;min-width:0;
}
.container{max-width:1050px;margin:auto;padding:20px}
h2{text-align:center;margin:30px 0}
.tools{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(210px,1fr));
  gap:18px;
}
.card{
  border:1px solid #eee;border-radius:15px;
  padding:25px;text-align:center;
  cursor:pointer;transition:.2s;
}
.card:hover{box-shadow:0 4px 15px #ddd;transform:translateY(-3px)}
.icon{font-size:35px}
.card h3{margin:12px 0 7px}
.card p{color:#777;font-size:14px}
.workspace{
  display:none;margin:40px auto;
  max-width:700px;padding:25px;
  border:1px solid #eee;border-radius:15px;
}
textarea{
  width:100%;height:150px;padding:15px;
  border:1px solid #ccc;border-radius:10px;
  font-size:16px;margin:12px 0;
}
button{
  background:#4285f4;color:white;
  border:0;padding:12px 20px;
  border-radius:8px;cursor:pointer;
  margin:5px;
}
button:hover{background:#286bd1}
#output{
  padding:15px;background:#f5f5f5;
  border-radius:8px;min-height:50px;
  overflow-wrap:anywhere;
}
footer{
  text-align:center;padding:30px;
  color:#777;border-top:1px solid #eee;
  margin-top:50px;
}
@media(max-width:500px){
 .hero h1{font-size:30px}
 header{padding:18px}
}
</style>
</head>
<body>

<header>
 <div class="logo">Hindi<span>Tools</span> Hub</div>
 <div>हिंदी ऑनलाइन टूल्स</div>
</header>

<section class="hero">
 <h1>Hindi Tools Hub</h1>
 <p>आपके सभी ऑनलाइन टूल्स एक ही जगह</p>
 <div class="search">
  <span>🔍</span>
  <input id="search" placeholder="अपना टूल खोजें...">
 </div>
</section>

<main class="container">
 <h2>हमारे ऑनलाइन टूल्स</h2>

 <div class="tools" id="tools">

  <div class="card" data-name="word counter शब्द गिनती"
   onclick="openTool('count')">
   <div class="icon">📝</div>
   <h3>Word Counter</h3>
   <p>शब्द और अक्षर गिनें</p>
  </div>

  <div class="card" data-name="uppercase lowercase text converter"
   onclick="openTool('case')">
   <div class="icon">🔠</div>
   <h3>Text Converter</h3>
   <p>बड़े और छोटे अक्षरों में बदलें</p>
  </div>

  <div class="card" data-name="remove extra spaces text cleaner"
   onclick="openTool('clean')">
   <div class="icon">✨</div>
   <h3>Text Cleaner</h3>
   <p>अतिरिक्त स्पेस हटाएँ</p>
  </div>

  <div class="card" data-name="reverse text उल्टा टेक्स्ट"
   onclick="openTool('reverse')">
   <div class="icon">🔄</div>
   <h3>Reverse Text</h3>
   <p>टेक्स्ट को उल्टा करें</p>
  </div>

 </div>

 <section class="workspace" id="workspace">
  <h2 id="toolTitle">Online Tool</h2>
  <textarea id="userText" placeholder="यहाँ अपना टेक्स्ट लिखें..."></textarea>
  <div>
   <button onclick="processText()">Convert करें</button>
   <button onclick="copyText()">Copy करें</button>
   <button onclick="clearText()">Clear करें</button>
  </div>
  <h3>Result</h3>
  <div id="output">आपका रिजल्ट यहाँ दिखाई देगा।</div>
  <p id="stats"></p>
 </section>
</main>

<footer>
 © 2026 Hindi Tools Hub | Made with ❤️
</footer>

<script>
let selectedTool = '';

document.getElementById('search').addEventListener('input',function(){
 const q=this.value.toLowerCase();
 document.querySelectorAll('.card').forEach(card=>{
  card.style.display=card.dataset.name.includes(q)
   ? 'block':'none';
 });
});

function openTool(tool){
 selectedTool=tool;
 document.getElementById('workspace').style.display='block';
 const titles={
  count:'Word Counter',
  case:'Text Converter',
  clean:'Text Cleaner',
  reverse:'Reverse Text'
 };
 document.getElementById('toolTitle').innerText=titles[tool];
 document.getElementById('workspace').scrollIntoView({behavior:'smooth'});
}

function processText(){
 const text=document.getElementById('userText').value;
 let result='';
 if(selectedTool==='count'){
  const words=text.trim()?text.trim().split(/\s+/).length:0;
  result='शब्द: '+words+' | अक्षर: '+text.length;
  document.getElementById('stats').innerText=result;
 }else if(selectedTool==='case'){
  result=text.toUpperCase()+'\n\n'+text.toLowerCase();
 }else if(selectedTool==='clean'){
  result=text.replace(/\s+/g,' ').trim();
 }else if(selectedTool==='reverse'){
  result=Array.from(text).reverse().join('');
 }
 document.getElementById('output').innerText=result;
}

function copyText(){
 const text=document.getElementById('output').innerText;
 navigator.clipboard.writeText(text)
 .then(()=>alert('Text copied!'))
 .catch(()=>alert('Copy नहीं हो पाया।'));
}

function clearText(){
 document.getElementById('userText').value='';
 document.getElementById('output').innerText='';
 document.getElementById('stats').innerText='';
}
</script>

</body>
</html><!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Hindi Tools Hub</title>
<style>
body{margin:0;font-family:Arial;background:#eef3fa;color:#172554}
header{background:#174ea6;color:white;text-align:center;padding:25px}
main{max-width:650px;margin:20px auto;padding:12px}
.card{background:white;padding:18px;border-radius:14px;margin:15px 0;box-shadow:0 2px 8px #ddd}
textarea,input{width:100%;box-sizing:border-box;padding:12px;margin:8px 0;border:1px solid #bbb;border-radius:8px;font-size:17px}
button{background:#1d5cba;color:white;border:0;padding:11px;border-radius:7px;margin:3px}
.keys{display:flex;flex-wrap:wrap;gap:4px}
</style>
</head>
<body>
<header>
<h1>Hindi Tools Hub</h1>
<p>हिंदी टाइपिंग और ऑनलाइन टूल्स</p>
</header>
<main>
<div class="card">
<h2>हिंदी टाइपिंग टूल</h2>
<textarea id="txt" rows="5" placeholder="यहाँ लिखें..."></textarea>
<div class="keys" id="keys"></div>
<button onclick="add(' ')">Space</button>
<button onclick="del()">⌫ मिटाएँ</button>
<button onclick="clearText()">Clear</button>
<button onclick="copyText()">Copy</button>
<p id="count">शब्द: 0 | अक्षर: 0</p>
</div>
<div class="card">
<h2>Percentage Calculator</h2>
<input id="marks" type="number" placeholder="प्राप्त अंक">
<input id="total" type="number" placeholder="कुल अंक">
<button onclick="calc()">प्रतिशत निकालें</button>
<p id="result"></p>
</div>
<div class="card">
<h2>Age Calculator</h2>
<input id="dob" type="date">
<button onclick="age()">उम्र निकालें</button>
<p id="ageResult"></p>
</div>
</main>
<script>
const letters="अ आ इ ई उ ऊ ए ऐ ओ औ अं अः क ख ग घ ङ च छ ज झ ञ ट ठ ड ढ ण त थ द ध न प फ ब भ म य र ल व श ष स ह क्ष त्र ज्ञ";
const area=document.getElementById("txt");
letters.split(" ").forEach(ch=>{
let b=document.createElement("button");
b.textContent=ch;
b.onclick=()=>add(ch);
document.getElementById("keys").appendChild(b);
});
function add(ch){area.value+=ch;update();}
function del(){area.value=area.value.slice(0,-1);update();}
function clearText(){area.value="";update();}
function update(){
let t=area.value.trim();
document.getElementById("count").textContent=
"शब्द: "+(t?t.split(/\s+/).length:0)+" | अक्षर: "+area.value.length;
}
area.addEventListener("input",update);
function copyText(){
area.select();
document.execCommand("copy");
alert("Text copied!");
}
function calc(){
let m=Number(document.getElementById("marks").value);
let t=Number(document.getElementById("total").value);
document.getElementById("result").textContent=
t>0&&m>=0&&m<=t?"प्रतिशत: "+(m/t*100).toFixed(2)+"%":"सही अंक डालें";
}
function age(){
let d=document.getElementById("dob").value;
let b=new Date(d+"T00:00:00"),n=new Date();
if(!d||b>n){document.getElementById("ageResult").textContent="सही जन्मतिथि डालें";return;}
let y=n.getFullYear()-b.getFullYear(),m=n.getMonth()-b.getMonth();
if(n.getDate()<b.getDate())m--;
if(m<0){y--;m+=12;}
document.getElementById("ageResult").textContent="उम्र: "+y+" साल "+m+" महीने";
}
</script>
</body>
</html>
